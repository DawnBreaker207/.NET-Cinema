{
  "ConnectionStrings": {
    "CinemaDb": "Host=localhost;Port=5433;Database=cinema;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "AccessSecret": "CHANGE-ME-access-secret-min-32-chars!!",
    "RefreshSecret": "CHANGE-ME-refresh-secret-min-32-chars!",
    "Issuer": "cinema",
    "AccessMinutes": 15,
    "RefreshHours": 168
  },
  "Booking": {
    "HoldMinutes": 10,
    "HoldMaxLifetimeMinutes": 15,
    "MaxSeatsPerOrder": 8,
    "RoomCleanupMinutes": 20
  },
  "Account": {
    "PasswordResetMinutes": 30,
    "PasswordResetUrl": "http://localhost:5173/reset-password"
  },
  "Legal": {
    "TermsVersion": 1
  },
  "Mail": {
    "OutboxDir": "tmp/mail"
  },
  "RateLimit": {
    "AuthPermitLimit": 60,
    "AuthWindowSeconds": 60,
    "HoldPermitLimit": 30,
    "HoldWindowSeconds": 60,
    "PublicPermitLimit": 120,
    "PublicWindowSeconds": 60,
    "LoginMaxFailures": 5,
    "LoginLockoutMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Payment": {
    "DefaultProvider": "mock",
    "MockEnabled": true,
    "MockSecret": "dev-mock-secret-change-me",
    "PublicBaseUrl": "http://localhost:5000",
    "ReturnRedirectUrl": "http://localhost:5173"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
