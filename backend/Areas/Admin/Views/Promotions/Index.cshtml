                    <span class="ant-date-shell" style="flex:1">
                        <input id="cm_f_to" type="datetime-local" required />
                        <span class="ant-date-ph">@Html.T("x.toDate")</span>
                    </span>
                    <span class="anticon ml-auto shrink-0 text-[var(--text-3)]">@Html.Raw(Icons.Get("Calendar"))</span>
                </div>
                <div class="ant-form-item-explain" id="cm_e_window" style="display:none"></div>
            </div>
            <div class="ant-form-item mb-0 mt-5">
                <label class="ant-form-item-label required">@Html.T("campaign.perUserLimit")</label>
                <input id="cm_f_limit" class="ant-input" type="number" min="1" />
                <div class="ant-form-item-explain" id="cm_e_limit" style="display:none"></div>
                <div class="mt-1 text-xs text-[var(--text-3)]">@Html.T("campaign.perUserLimitHint")</div>
            </div>
            <div class="ant-form-item mb-0 mt-5">
                <label class="ant-form-item-label">@Html.T("campaign.description")</label>
                <textarea id="cm_f_desc" class="ant-input" rows="2"></textarea>
                <div class="ant-form-item-explain" id="cm_e_desc" style="display:none"></div>
            </div>
        </div>
        <div class="ant-modal-footer">
            <button type="button" class="ant-btn" data-close="cm_modal">@Html.T("common.cancel")</button>
            <button type="button" class="ant-btn ant-btn-primary" id="cm_save">@Html.T("common.save")</button>
        </div>
    </div>
</div>

<div class="ant-modal-mask" id="cm_links">
    <div class="ant-modal" style="max-width:620px">
        <div class="ant-modal-header">
            <span class="ant-modal-title">@Html.T("campaign.linksTitle")</span>
            <button type="button" class="ant-modal-close" data-close="cm_links"><span class="anticon">@Html.Raw(Icons.Get("Close"))</span></button>
        </div>
        <div class="ant-modal-body">
            <h5 class="mb-2 text-base font-semibold text-white">@Html.T("campaign.linkedCodes")</h5>
            <div class="mb-2 flex flex-wrap gap-2" id="cm_lk_codes"></div>
            <div class="mb-5 flex">
                <select id="cm_lk_code_pick" class="ant-input rounded-r-none"></select>
                <button type="button" class="ant-btn ant-btn-primary -ml-px shrink-0 rounded-l-none" id="cm_lk_code_add">@Html.T("campaign.attach")</button>
            </div>
            <h5 class="mb-2 text-base font-semibold text-white">@Html.T("campaign.linkedCombos")</h5>
            <div class="mb-2 flex flex-wrap gap-2" id="cm_lk_combos"></div>
            <div class="mb-5 flex">
                <select id="cm_lk_combo_pick" class="ant-input rounded-r-none"></select>
                <button type="button" class="ant-btn ant-btn-primary -ml-px shrink-0 rounded-l-none" id="cm_lk_combo_add">@Html.T("campaign.attach")</button>
            </div>
            <h5 class="mb-2 text-base font-semibold text-white">@Html.T("campaign.linkedArticles")</h5>
            <div class="mb-2 flex flex-wrap gap-2" id="cm_lk_articles"></div>
            <div class="flex">
                <select id="cm_lk_article_pick" class="ant-input rounded-r-none"></select>
                <button type="button" class="ant-btn ant-btn-primary -ml-px shrink-0 rounded-l-none" id="cm_lk_article_add">@Html.T("campaign.attach")</button>
            </div>
        </div>
    </div>
</div>

<div class="ant-drawer-mask" id="ar_d_mask"></div>
<aside class="ant-drawer" id="ar_drawer" style="width:640px" aria-hidden="true">
    <div class="ant-drawer-header">
        <span class="text-sm font-semibold text-white" id="ar_d_title">@Html.T("article.createTitle")</span>
        <div class="flex items-center gap-2">
            <button type="button" class="ant-btn" id="ar_cancel">@Html.T("common.cancel")</button>
            <button type="button" class="ant-btn ant-btn-primary" id="ar_save">@Html.T("common.save")</button>
            <button type="button" class="ant-btn ant-btn-text ant-btn-icon" id="ar_d_close" aria-label="@Html.T("x.drawerClose")"><span class="anticon">@Html.Raw(Icons.Get("Close"))</span></button>
        </div>
    </div>
    <div class="ant-drawer-body">
        <div class="ant-form-item mb-0">
            <label class="ant-form-item-label required">@Html.T("article.title")</label>
            <input id="ar_f_title" class="ant-input" />
            <div class="ant-form-item-explain" id="ar_e_title" style="display:none"></div>
        </div>
        <div class="ant-form-item mb-0 mt-5">
            <label class="ant-form-item-label">@Html.T("article.slug")</label>
            <input id="ar_f_slug" class="ant-input" disabled readonly />
        </div>
        <div class="ant-form-item mb-0 mt-5">
            <label class="ant-form-item-label required">@Html.T("article.type")</label>
            <select id="ar_f_type" class="ant-input">
                <option value="news">@Html.T("article.typeNews")</option>
                <option value="promotion">@Html.T("article.typePromotion")</option>
            </select>
            <div class="ant-form-item-explain" id="ar_e_type" style="display:none"></div>
        </div>
        <div class="ant-form-item mb-0 mt-5">
            <label class="ant-form-item-label">@Html.T("article.summary")</label>
            <textarea id="ar_f_summary" class="ant-input" rows="2"></textarea>
            <div class="ant-form-item-explain" id="ar_e_summary" style="display:none"></div>
        </div>
        <div class="ant-form-item mb-0 mt-5">
            <label class="ant-form-item-label">@Html.T("article.thumbnail")</label>
            <div class="ant-input-affix">
                <input id="ar_f_thumb" class="ant-input" placeholder="https://..." maxlength="1024" />
                <span class="ant-input-suffix" id="ar_thumb_btn"><span class="anticon">@Html.Raw(Icons.Get("Upload"))</span></span>
            </div>
            <input type="file" id="ar_thumb_file" class="hidden" accept="image/jpeg,image/png,image/webp" />
            <div class="ant-form-item-explain" id="ar_e_thumb" style="display:none"></div>
        </div>
        <div class="ant-form-item mb-0 mt-5" id="ar_thumb_prev_wrap" style="display:none">
            <label class="ant-form-item-label">@Html.T("article.thumbnailPreview")</label>
            <img id="ar_thumb_prev" width="160" height="90" style="border-radius:8px;object-fit:cover" alt="" />
        </div>
        <div class="ant-form-item mb-0 mt-5">
            <label class="ant-form-item-label required">@Html.T("article.content")</label>
            <div id="ar_f_editor"></div>
            <div class="ant-form-item-explain" id="ar_e_content" style="display:none"></div>
        </div>
    </div>
</aside>

@section Scripts {
    <link rel="stylesheet" href="/vendor/quill.snow.css" />
    <script src="/vendor/quill.js"></script>
    <script src="/js/promotions.js"></script>
}
